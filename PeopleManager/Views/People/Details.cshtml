@model PeopleManager.Models.Person

@{
    ViewData["Title"] = "Person Details";
}

<h1>Person Details</h1>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FirstName)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.FirstName)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.LastName)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.LastName)</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Email)</dd>

            <dt class="col-sm-4">Age</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Age)</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
